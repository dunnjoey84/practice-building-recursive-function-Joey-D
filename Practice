function reverseString(str) {
  // Base case: if the string has 1 or fewer characters
  if (str.length <= 1) {
    return str;
  }

    return str[str.length - 1] + reverseString(str.slice(0, -1));
}

console.log(reverseString("hello")); 
console.log(reverseString("Joey"));
console.log(reverseString("This isnt so bad."));